# Copy this file to ".env" (same folder as deep_oq_all.py) and fill in your keys.
# NEVER commit .env or share it. If a key was ever pasted somewhere public, revoke it and create a new one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# optional
DEEP_OQ_PROVIDER_ORDER=anthropic,openai,gemini,groq
DEEP_OQ_MODE=failover
